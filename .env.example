# Groq API (Llama 3.3 70B) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Tavily Search — https://tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith — https://smith.langchain.com (free tier: 5000 traces/month)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=deriv-research-agent
